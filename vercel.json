{
    "version": 2,
    "installCommand": "npm run install:all",
    "buildCommand": "npm run build",
    "functions": {
        "server.js": {
            "includeFiles": "public/**"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/server.js"
        }
    ]
}