{
  "name": "monte-castro-smart-climate",
  "version": "2.0.0",
  "description": "Monitoreo climático y confort térmico en Monte Castro (CABA) para la ET 35 Ing. Eduardo Latzina",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev:backend": "node server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install && npm install --prefix frontend"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
